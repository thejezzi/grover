# Format reference for `grover`; nothing copies it. `grover config --init` asks for the
# values and writes only the ones you enter, `grover config` edits them on a terminal.
# The editor writes resolved, absolute paths and fills in `clone_dir`, so a committed or
# shared config is edited by hand. The file is read from ./grover.yaml, else
# $XDG_CONFIG_HOME/grover/config.yaml, or from `grover --config <path>`. Relative paths
# are relative to this file, `~` is the home directory.

# Required: ticket directories are created here.
work_dir: "~/work/tickets"

# Branch name; `{ticket}` is required and replaced by the ticket slug.
branch_template: "ticket/{ticket}"

# Create the ticket branch in each worktree. Off (the default) leaves every worktree
# detached at the base ref: nothing to push, nothing to clean up per repo.
create_branch: false

# Base refs for new branches, tried left to right per repo.
base: "main|master|HEAD"     # first ref that exists in the repo wins

# Directories whose child repos are discovered as local repos.
repo_dirs:
  - "~/code"

# Destination for clones from `repos` and `discover`. Optional: leave it out and only
# `repo_dirs` is used.
clone_dir: "~/.grover/repos"

# Repos cloned only when selected. A local repo from `repo_dirs` wins on the same name.
repos:
  - url: "git@github.com:org/api.git"
    name: api                    # optional, otherwise derived from the URL

# Commands that print clone URLs, one per line. Any CLI works: `gh`, `bb`, `glab`,
# or your own script. `# ` starts a comment. Needs `clone_dir`.
# `--limit` caps the list silently: a too small value hides repos without an error,
# and both flags below keep forks and archived repos out of the picker.
discover:
  - "gh repo list my-org --limit 4000 --source --no-archived \
     --json sshUrl -q '.[].sshUrl'"

# Files copied into the ticket directory; `to` is relative to that directory.
copy:
  - from: "~/templates/AGENTS.md"
    to: AGENTS.md                # optional, otherwise the file name

# Commands run in order after each new worktree is created.
setup:
  - "npm install"
